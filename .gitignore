.DS_Store

# ZKP — ignore node_modules, ptau, witness files, and compiled outputs; keep circuit source
zkp/**/node_modules/
zkp/**/*.ptau
zkp/**/*.wtns
zkp/**/outputs/

# Allow the circuit source files
!zkp/
!zkp/element_threshold/
!zkp/element_threshold/circuits/
!zkp/element_threshold/circuits/*.circom

# Allow static ZKP browser artifacts
!static/zkp/
!static/zkp/**

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Env
.env

# IDE
.idea/
.vscode/
ToDo.txt
*notes*
/sample_data
seed.py
*test*